{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://coastlinesec.github.io/hyprshelld/schemas/components/v1/manifest.schema.json",
  "title": "HyprShelld component manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifestVersion",
    "id",
    "version",
    "type",
    "name",
    "description",
    "authors",
    "license",
    "componentApiVersion",
    "runtime"
  ],
  "properties": {
    "manifestVersion": {"const": 1},
    "id": {
      "type": "string",
      "maxLength": 255,
      "pattern": "^[a-z](?:[a-z0-9-]{0,61}[a-z0-9])?(?:\\.[a-z](?:[a-z0-9-]{0,61}[a-z0-9])?){2,}$"
    },
    "version": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "type": {
      "enum": [
        "bar-widget",
        "desktop-widget",
        "shell-application",
        "shell-service"
      ]
    },
    "name": {"$ref": "#/$defs/name"},
    "description": {"$ref": "#/$defs/description"},
    "authors": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {"$ref": "#/$defs/author"}
    },
    "license": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9.+:() -]+$"
    },
    "homepage": {"$ref": "#/$defs/webUrl"},
    "source": {"$ref": "#/$defs/webUrl"},
    "issues": {"$ref": "#/$defs/webUrl"},
    "componentApiVersion": {
      "type": "string",
      "maxLength": 32,
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "runtime": {"$ref": "#/$defs/runtime"},
    "settingsSchema": {"const": "settings.schema.json"},
    "requestedCapabilities": {
      "type": "array",
      "maxItems": 64,
      "items": {"$ref": "#/$defs/capability"}
    },
    "dependencies": {
      "type": "array",
      "maxItems": 64,
      "items": {"$ref": "#/$defs/dependency"}
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "type": {"enum": ["bar-widget", "desktop-widget"]}
        }
      },
      "then": {
        "properties": {
          "runtime": {
            "properties": {
              "kind": {
                "enum": ["builtin-v1", "declarative-v1", "qml-full-trust-v1"]
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "runtime": {"properties": {"kind": {"const": "process-v1"}}}
        }
      }
    }
  ],
  "$defs": {
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "webUrl": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048,
      "pattern": "^https?://"
    },
    "author": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": {"$ref": "#/$defs/name"},
        "email": {"type": "string", "minLength": 3, "maxLength": 254},
        "homepage": {"$ref": "#/$defs/webUrl"}
      }
    },
    "runtime": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "factory"],
          "properties": {
            "kind": {"const": "builtin-v1"},
            "factory": {
              "type": "string",
              "maxLength": 64,
              "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "entrypoint"],
          "properties": {
            "kind": {"enum": ["declarative-v1", "qml-full-trust-v1"]},
            "entrypoint": {"$ref": "#/$defs/entrypoint"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "entrypoint"],
          "properties": {
            "kind": {"const": "process-v1"},
            "entrypoint": {"$ref": "#/$defs/entrypoint"},
            "arguments": {
              "type": "array",
              "maxItems": 32,
              "items": {"type": "string", "maxLength": 1024}
            }
          }
        }
      ]
    },
    "entrypoint": {
      "type": "string",
      "maxLength": 255,
      "pattern": "^payload/[A-Za-z0-9][A-Za-z0-9._-]*(?:/[A-Za-z0-9][A-Za-z0-9._-]*)*$"
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "reason"],
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 255,
          "pattern": "^[a-z](?:[a-z0-9-]{0,61}[a-z0-9])?(?:\\.[a-z](?:[a-z0-9-]{0,61}[a-z0-9])?)+$"
        },
        "reason": {"type": "string", "minLength": 1, "maxLength": 1024}
      }
    },
    "dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 255,
          "pattern": "^[a-z](?:[a-z0-9-]{0,61}[a-z0-9])?(?:\\.[a-z](?:[a-z0-9-]{0,61}[a-z0-9])?){2,}$"
        },
        "version": {"type": "string", "minLength": 1, "maxLength": 256}
      }
    }
  }
}
