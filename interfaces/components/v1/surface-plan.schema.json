{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hyprshelld.org/schemas/components/v1/surface-plan.schema.json",
  "title": "HyprShelld surface activation plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "formatVersion",
    "catalogDigest",
    "configurationRevision",
    "instances",
    "layouts"
  ],
  "properties": {
    "formatVersion": {
      "const": 1
    },
    "catalogDigest": {
      "$ref": "#/$defs/sha256"
    },
    "configurationRevision": {
      "$ref": "#/$defs/revision"
    },
    "instances": {
      "type": "object",
      "maxProperties": 512,
      "additionalProperties": false,
      "patternProperties": {
        "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$": {
          "$ref": "#/$defs/instance"
        }
      }
    },
    "layouts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bars"],
      "properties": {
        "bars": {
          "type": "object",
          "maxProperties": 64,
          "additionalProperties": false,
          "patternProperties": {
            "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$": {
              "$ref": "#/$defs/barLayout"
            }
          }
        }
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "revision": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,19})$"
    },
    "componentId": {
      "type": "string",
      "minLength": 3,
      "maxLength": 255,
      "pattern": "^[a-z](?:[a-z0-9-]{0,61}[a-z0-9])?(?:\\.[a-z](?:[a-z0-9-]{0,61}[a-z0-9])?){2,}$"
    },
    "factoryKey": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "instanceId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "factory"],
      "properties": {
        "kind": {
          "const": "builtin-v1"
        },
        "factory": {
          "$ref": "#/$defs/factoryKey"
        }
      }
    },
    "instance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "componentId",
        "componentType",
        "packageDigest",
        "runtime",
        "settings"
      ],
      "properties": {
        "componentId": {
          "$ref": "#/$defs/componentId"
        },
        "componentType": {
          "const": "bar-widget"
        },
        "packageDigest": {
          "$ref": "#/$defs/sha256"
        },
        "runtime": {
          "$ref": "#/$defs/runtime"
        },
        "settings": {
          "type": "object",
          "maxProperties": 128
        }
      }
    },
    "outputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode"],
      "properties": {
        "mode": {
          "const": "all"
        }
      }
    },
    "region": {
      "type": "array",
      "maxItems": 512,
      "items": {
        "$ref": "#/$defs/instanceId"
      }
    },
    "regions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "center", "end"],
      "properties": {
        "start": {
          "$ref": "#/$defs/region"
        },
        "center": {
          "$ref": "#/$defs/region"
        },
        "end": {
          "$ref": "#/$defs/region"
        }
      }
    },
    "barLayout": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outputs", "regions"],
      "properties": {
        "outputs": {
          "$ref": "#/$defs/outputs"
        },
        "regions": {
          "$ref": "#/$defs/regions"
        }
      }
    }
  }
}
