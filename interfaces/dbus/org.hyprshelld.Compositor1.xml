<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE node PUBLIC
  "-//freedesktop//DTD D-BUS Object Introspection 1.0//EN"
  "https://www.freedesktop.org/standards/dbus/1.0/introspect.dtd">
<node name="/org/hyprshelld/Compositor1">
  <interface name="org.hyprshelld.Compositor1">
    <!--
      Legacy compatibility sentinel. Once the version-2 authority contract is
      present, this object is registered from process start but never opens a
      revision-only mutation window. Available and Writable remain permanently
      false, so no legacy desired-state property tuple is authoritative. The
      exact readable-method allowlist is GetConnectedDisplays and
      GetConnectedInputDevices. Every other method, including all desired-state
      reads, catalog reads, confirmation-capability reads, and every mutation,
      permanently returns org.hyprshelld.Compositor1.Error.UpgradeRequired.
      A client that receives UpgradeRequired must move to
      org.hyprshelld.Compositor2 and must not fall back to this interface.
      Historical per-member prose below preserves the legacy ABI record but
      does not widen this exhaustive allowlist.
    -->

    <!-- Legacy sentinel value: permanently false once Compositor2 is present. -->
    <property name="Available" type="b" access="read">
      <annotation
        name="org.freedesktop.DBus.Property.EmitsChangedSignal"
        value="true"/>
    </property>

    <!--
      Legacy sentinel value: permanently false once Compositor2 is present.
      It never reports a revision-only writable interval.
    -->
    <property name="Writable" type="b" access="read">
      <annotation
        name="org.freedesktop.DBus.Property.EmitsChangedSignal"
        value="true"/>
    </property>

    <property name="Revision" type="t" access="read">
      <annotation
        name="org.freedesktop.DBus.Property.EmitsChangedSignal"
        value="true"/>
    </property>

    <!-- One of normal, recovered, defaulted, unsupported, or unavailable. -->
    <property name="LoadState" type="s" access="read">
      <annotation
        name="org.freedesktop.DBus.Property.EmitsChangedSignal"
        value="true"/>
    </property>

    <!--
      One of unmanaged, managed, preview, or conflict. Ownership is never implicit.
      The value is re-probed when the config root changes and before every
      live activation, adoption, or recovery operation; managed requires the
      entrypoint, ownership record, and authority GenerationDigest to identify
      the same verified generation.
    -->
    <property name="ManagementState" type="s" access="read">
      <annotation
        name="org.freedesktop.DBus.Property.EmitsChangedSignal"
        value="true"/>
    </property>

    <!--
      Exact SHA-256 of the most recently safely re-probed regular compositor
      entrypoint. Empty means the entrypoint is absent or cannot safely be
      represented as regular bytes. Config-root changes trigger another probe
      and PropertiesChanged when this observation changes.
    -->
    <property name="EntrypointDigest" type="s" access="read">
      <annotation
        name="org.freedesktop.DBus.Property.EmitsChangedSignal"
        value="true"/>
    </property>

    <property name="CatalogDigest" type="s" access="read">
      <annotation
        name="org.freedesktop.DBus.Property.EmitsChangedSignal"
        value="true"/>
    </property>

    <property name="ActionCatalogDigest" type="s" access="read">
      <annotation
        name="org.freedesktop.DBus.Property.EmitsChangedSignal"
        value="true"/>
    </property>

    <!--
      Zero when no managed generation has been activated, or when revision zero
      itself is active. ApplyState and GenerationDigest disambiguate the tuple.
    -->
    <property name="AppliedRevision" type="t" access="read">
      <annotation
        name="org.freedesktop.DBus.Property.EmitsChangedSignal"
        value="true"/>
    </property>

    <!-- One of unavailable, inactive, current, retained, or failed. -->
    <property name="ApplyState" type="s" access="read">
      <annotation
        name="org.freedesktop.DBus.Property.EmitsChangedSignal"
        value="true"/>
    </property>

    <!--
      One of none, reload, restart, or session. The live executor can confirm
      reload in this contract version. Restart and session remain explicit
      pending requirements and fail activation with ActivationRequired.
    -->
    <property name="RequiredActivation" type="s" access="read">
      <annotation
        name="org.freedesktop.DBus.Property.EmitsChangedSignal"
        value="true"/>
    </property>

    <!-- Empty exactly when no managed generation has been activated. -->
    <property name="GenerationDigest" type="s" access="read">
      <annotation
        name="org.freedesktop.DBus.Property.EmitsChangedSignal"
        value="true"/>
    </property>

    <!--
      One of idle, awaiting-confirmation, reverting, committing, or failed. A
      preview is a live, receipt-bound N+1 generation; durable desired/applied
      authority remains N until the initiating caller confirms it. Committing
      is non-actionable: the one-way authority decision may already exist and
      neither timeout nor a caller may roll the live target back.
    -->
    <property name="DisplayConfirmationState" type="s" access="read">
      <annotation
        name="org.freedesktop.DBus.Property.EmitsChangedSignal"
        value="true"/>
    </property>

    <!-- Transient N+1 while awaiting confirmation; zero otherwise. -->
    <property name="DisplayConfirmationRevision" type="t" access="read">
      <annotation
        name="org.freedesktop.DBus.Property.EmitsChangedSignal"
        value="true"/>
    </property>

    <!-- UTC Unix milliseconds for presentation; zero otherwise. Enforcement uses a monotonic deadline. -->
    <property name="DisplayConfirmationDeadlineMs" type="t" access="read">
      <annotation
        name="org.freedesktop.DBus.Property.EmitsChangedSignal"
        value="true"/>
    </property>

    <!-- Transient generation digest while awaiting confirmation; empty otherwise. -->
    <property name="DisplayConfirmationGeneration" type="s" access="read">
      <annotation
        name="org.freedesktop.DBus.Property.EmitsChangedSignal"
        value="true"/>
    </property>

    <!--
      One of unavailable, override, pending, saved, current, or failed.
      Synchronization consumes the independently verified Config1 shared-border
      projection and never adopts an unmanaged compositor entrypoint.
    -->
    <property name="SharedBorderSyncState" type="s" access="read">
      <annotation
        name="org.freedesktop.DBus.Property.EmitsChangedSignal"
        value="true"/>
    </property>

    <!--
      Exact Config1 revision for the verified projection; zero while the Config1
      source is unavailable.
    -->
    <property name="SharedBorderSourceRevision" type="t" access="read">
      <annotation
        name="org.freedesktop.DBus.Property.EmitsChangedSignal"
        value="true"/>
    </property>

    <!-- Empty outside unavailable or failed synchronization states. -->
    <property name="SharedBorderSyncError" type="s" access="read">
      <annotation
        name="org.freedesktop.DBus.Property.EmitsChangedSignal"
        value="true"/>
    </property>

    <!--
      One of unavailable, override, pending, saved, current, or failed.
      Synchronization consumes the independently verified Config1 spacing
      projection, while the protected maximized-window rule remains enforced
      even when ordinary global spacing is overridden.
    -->
    <property name="SharedSpacingSyncState" type="s" access="read">
      <annotation
        name="org.freedesktop.DBus.Property.EmitsChangedSignal"
        value="true"/>
    </property>

    <!--
      Exact Config1 revision for the verified projection; zero while the Config1
      source is unavailable.
    -->
    <property name="SharedSpacingSourceRevision" type="t" access="read">
      <annotation
        name="org.freedesktop.DBus.Property.EmitsChangedSignal"
        value="true"/>
    </property>

    <!-- Empty outside unavailable or failed synchronization states. -->
    <property name="SharedSpacingSyncError" type="s" access="read">
      <annotation
        name="org.freedesktop.DBus.Property.EmitsChangedSignal"
        value="true"/>
    </property>

    <!--
      Returns one complete canonical desired-state document and the revision
      that owns those exact bytes.

      Errors:
        org.hyprshelld.Compositor1.Error.Unavailable
    -->
    <method name="GetSnapshot">
      <arg name="snapshot" type="ay" direction="out"/>
      <arg name="revision" type="t" direction="out"/>
      <arg name="catalogDigest" type="s" direction="out"/>
      <arg name="actionCatalogDigest" type="s" direction="out"/>
    </method>

    <!--
      Returns the exact canonical scalar-option catalog retained by the
      desired-state authority. The document is bounded to 4 MiB and its
      SHA-256 digest must equal the current CatalogDigest property and the
      digest returned here.

      Errors:
        org.hyprshelld.Compositor1.Error.Unavailable
    -->
    <method name="GetOptionCatalog">
      <arg name="optionCatalog" type="ay" direction="out"/>
      <arg name="catalogDigest" type="s" direction="out"/>
    </method>

    <!--
      Returns the canonical reviewed action catalog together with the exact
      config-schema bytes authenticated by it. The action catalog is bounded
      to 1 MiB and the schema to 2 MiB. actionCatalogDigest is the combined
      reviewed digest for both documents and must equal the current
      ActionCatalogDigest property; configSchemaDigest is the SHA-256 of the
      exact schema bytes returned here. Both documents come from the already
      parsed retained authority: this method never reopens their source paths
      and never mutates desired state, persistent or generated files, the
      managed entrypoint, or live Hyprland configuration.

      Errors:
        org.hyprshelld.Compositor1.Error.Unavailable
    -->
    <method name="GetActionCatalog">
      <arg name="actionCatalog" type="ay" direction="out"/>
      <arg name="actionCatalogDigest" type="s" direction="out"/>
      <arg name="configSchema" type="ay" direction="out"/>
      <arg name="configSchemaDigest" type="s" direction="out"/>
    </method>

    <!--
      Replaces the complete desired state using a revision compare-and-swap.
      The candidate embeds expectedRevision; compositord owns exactly one
      monotonic increment. An exact retry with the immediately preceding token
      after a lost successful response returns the already-committed revision;
      it never increments twice. This operation does not activate or reload
      Hyprland.

      Before persistence, replacement resolves shared-visual authority from the
      current verified Config1 projection, then the retained last verified
      projection, then the current desired resolved values. The candidate must
      preserve each synchronized border and spacing value unless the resolved
      group policy explicitly permits an override. It must always contain the
      exact unique final protected maximized-window rule. A divergent protected
      value or missing or altered protected rule causes ControlledByHyprShelld
      before desired state is replaced.

      Errors:
        org.hyprshelld.Compositor1.Error.ConfirmationPending
        org.hyprshelld.Compositor1.Error.Unavailable
        org.hyprshelld.Compositor1.Error.ReadOnly
        org.hyprshelld.Compositor1.Error.StaleRevision
        org.hyprshelld.Compositor1.Error.StaleCatalogDigest
        org.hyprshelld.Compositor1.Error.InvalidSnapshot
        org.hyprshelld.Compositor1.Error.RevisionExhausted
        org.hyprshelld.Compositor1.Error.PersistenceFailed
        org.hyprshelld.Compositor1.Error.ControlledByHyprShelld
    -->
    <method name="ReplaceSnapshot">
      <arg name="expectedRevision" type="t" direction="in"/>
      <arg name="expectedCatalogDigest" type="s" direction="in"/>
      <arg name="expectedActionCatalogDigest" type="s" direction="in"/>
      <arg name="candidateSnapshot" type="ay" direction="in"/>
      <arg name="revision" type="t" direction="out"/>
    </method>

    <!--
      Builds and atomically activates an immutable managed Lua generation for
      exactly expectedRevision. An idempotent apply returns the current
      generation without rebuilding it. For a reload requirement, compositord
      journals the prior and target entrypoints before atomic publication,
      connects to the exact running Hyprland instance, and accepts convergence
      only after the target's exact custom activation-nonce event, the following
      configreloaded event, a successful reload reply, and an empty JSON
      configerrors result. Restart and session requirements fail with
      ActivationRequired before entrypoint publication.

      Before generation preparation, Apply requires a currently verified,
      available Config1 shared-visual authority. Unavailable or unverified
      authority causes ControlledByHyprShelld even when the last verified
      border or spacing policy was an override. With a current verified
      projection, an explicit group synchronization override permits divergent
      saved values for that group. Synchronized-value divergence or a missing
      or altered exact protected maximized-window rule causes
      ControlledByHyprShelld before any generation is prepared or activated.

      Errors:
        org.hyprshelld.Compositor1.Error.ConfirmationPending
        org.hyprshelld.Compositor1.Error.Unavailable
        org.hyprshelld.Compositor1.Error.ReadOnly
        org.hyprshelld.Compositor1.Error.StaleRevision
        org.hyprshelld.Compositor1.Error.StaleCatalogDigest
        org.hyprshelld.Compositor1.Error.AdoptionRequired
        org.hyprshelld.Compositor1.Error.EntrypointChanged
        org.hyprshelld.Compositor1.Error.ActivationRequired
        org.hyprshelld.Compositor1.Error.VerificationFailed
        org.hyprshelld.Compositor1.Error.RuntimeUnavailable
        org.hyprshelld.Compositor1.Error.UnsupportedVersion
        org.hyprshelld.Compositor1.Error.ReloadFailed
        org.hyprshelld.Compositor1.Error.PersistenceFailed
        org.hyprshelld.Compositor1.Error.ApplyFailed
        org.hyprshelld.Compositor1.Error.ControlledByHyprShelld
    -->
    <method name="Apply">
      <arg name="expectedRevision" type="t" direction="in"/>
      <arg name="expectedCatalogDigest" type="s" direction="in"/>
      <arg name="expectedActionCatalogDigest" type="s" direction="in"/>
      <arg name="appliedRevision" type="t" direction="out"/>
      <arg name="generationDigest" type="s" direction="out"/>
    </method>

    <!--
      Copies the last successfully applied snapshot into a new desired-state
      revision, then prepares, verifies, and activates that exact content. The
      new revision is expectedRevision + 1; an older revision is never restored
      or reused. Recovery never adopts an unmanaged compositor entrypoint. A
      reload recovery uses the same durable entrypoint journal and exact live
      proof as Apply. Restart and session requirements return
      ActivationRequired before entrypoint publication. Recover is intentionally
      exempt from the shared-visual ownership gate because it restores the
      whole-compositor last-known-good state. Normal reconciliation then
      reasserts the current shared-border and shared-spacing policies and the
      exact protected maximized-window rule.

      Errors:
        org.hyprshelld.Compositor1.Error.ConfirmationPending
        org.hyprshelld.Compositor1.Error.Unavailable
        org.hyprshelld.Compositor1.Error.ReadOnly
        org.hyprshelld.Compositor1.Error.StaleRevision
        org.hyprshelld.Compositor1.Error.StaleCatalogDigest
        org.hyprshelld.Compositor1.Error.AdoptionRequired
        org.hyprshelld.Compositor1.Error.EntrypointChanged
        org.hyprshelld.Compositor1.Error.RecoveryUnavailable
        org.hyprshelld.Compositor1.Error.ActivationRequired
        org.hyprshelld.Compositor1.Error.VerificationFailed
        org.hyprshelld.Compositor1.Error.RuntimeUnavailable
        org.hyprshelld.Compositor1.Error.UnsupportedVersion
        org.hyprshelld.Compositor1.Error.ReloadFailed
        org.hyprshelld.Compositor1.Error.PersistenceFailed
        org.hyprshelld.Compositor1.Error.RecoveryFailed
    -->
    <method name="Recover">
      <arg name="expectedRevision" type="t" direction="in"/>
      <arg name="expectedCatalogDigest" type="s" direction="in"/>
      <arg name="expectedActionCatalogDigest" type="s" direction="in"/>
      <arg name="revision" type="t" direction="out"/>
      <arg name="appliedRevision" type="t" direction="out"/>
      <arg name="generationDigest" type="s" direction="out"/>
    </method>

    <!--
      Explicitly adopts the compositor entrypoint at one CAS-qualified desired
      state. An empty expectedEntrypointDigest is valid only when the entrypoint
      is absent. A non-empty value binds the exact existing regular-file bytes;
      compositord durably preserves a recoverable original and activation
      journal before it stages, verifies, and atomically publishes the managed
      entrypoint. Ownership is finalized only after exact live Reload proof and
      the authority commit. Startup reconciles an interrupted journal without
      implicitly adopting unrelated bytes. This method is never invoked
      automatically during startup. Restart and session requirements return
      ActivationRequired before entrypoint publication.

      Before staging, adoption applies the same shared-visual ownership check
      as Apply. It requires a currently verified, available Config1 authority;
      unavailable or unverified authority causes ControlledByHyprShelld even
      when the last verified border or spacing policy was an override. A current
      group synchronization override permits divergent saved values for that
      group. Synchronized-value divergence or a missing or altered exact
      protected maximized-window rule causes ControlledByHyprShelld before any
      generation is prepared or entrypoint is adopted.

      Errors:
        org.hyprshelld.Compositor1.Error.ConfirmationPending
        org.hyprshelld.Compositor1.Error.Unavailable
        org.hyprshelld.Compositor1.Error.ReadOnly
        org.hyprshelld.Compositor1.Error.StaleRevision
        org.hyprshelld.Compositor1.Error.StaleCatalogDigest
        org.hyprshelld.Compositor1.Error.EntrypointChanged
        org.hyprshelld.Compositor1.Error.ActivationRequired
        org.hyprshelld.Compositor1.Error.VerificationFailed
        org.hyprshelld.Compositor1.Error.RuntimeUnavailable
        org.hyprshelld.Compositor1.Error.UnsupportedVersion
        org.hyprshelld.Compositor1.Error.ReloadFailed
        org.hyprshelld.Compositor1.Error.PersistenceFailed
        org.hyprshelld.Compositor1.Error.ApplyFailed
        org.hyprshelld.Compositor1.Error.ControlledByHyprShelld
    -->
    <method name="AdoptManagedConfiguration">
      <arg name="expectedRevision" type="t" direction="in"/>
      <arg name="expectedCatalogDigest" type="s" direction="in"/>
      <arg name="expectedActionCatalogDigest" type="s" direction="in"/>
      <arg name="expectedEntrypointDigest" type="s" direction="in"/>
      <arg name="appliedRevision" type="t" direction="out"/>
      <arg name="generationDigest" type="s" direction="out"/>
      <arg name="entrypointDigest" type="s" direction="out"/>
    </method>

    <!--
      Returns a filtered canonical v1 topology and its UTC observation time.
      Ordinarily this comes from a fresh authenticated `j/monitors all`
      query. While awaiting display confirmation, it returns the cached exact
      post-proof topology immediately so discovery cannot starve the monotonic
      rollback deadline. Upstream JSON is never forwarded directly.

      Errors:
        org.hyprshelld.Compositor1.Error.Unavailable
        org.hyprshelld.Compositor1.Error.RuntimeUnavailable
        org.hyprshelld.Compositor1.Error.UnsupportedVersion
        org.hyprshelld.Compositor1.Error.VerificationFailed
    -->
    <method name="GetConnectedDisplays">
      <arg name="topology" type="ay" direction="out"/>
      <arg name="observedAtMs" type="t" direction="out"/>
    </method>

    <!--
      Returns a filtered canonical v1 inventory and its UTC observation time
      from a fresh authenticated `j/devices` query. Raw runtime addresses are
      retained only in the private opaque inventory fingerprint and never
      cross D-Bus. This read-only view is independent of desired-state and
      managed-filesystem authority. It is unavailable while a display
      confirmation capability still exists or its durable commit is active,
      and old observations are not cached as current.

      Errors:
        org.hyprshelld.Compositor1.Error.Unavailable
        org.hyprshelld.Compositor1.Error.RuntimeUnavailable
        org.hyprshelld.Compositor1.Error.UnsupportedVersion
        org.hyprshelld.Compositor1.Error.VerificationFailed
    -->
    <method name="GetConnectedInputDevices">
      <arg name="inventory" type="ay" direction="out"/>
      <arg name="observedAtMs" type="t" direction="out"/>
    </method>

    <!--
      Stages and proves a monitor-only transient N+1. The supplied canonical
      profile is bound to a fresh topology fingerprint and must cover exactly
      the connected connector names while leaving at least one usable output.
      Desired, last-good, and activation authority remain N. After proof the
      initiating unique bus owner receives a private 128-bit confirmation
      token and a 10..30 second monotonic deadline. Owner disappearance,
      timeout, topology/runtime change, or failed realization rolls live state
      back and aborts N+1.

      Errors:
        org.hyprshelld.Compositor1.Error.ConfirmationPending
        org.hyprshelld.Compositor1.Error.ConfirmationExpired
        org.hyprshelld.Compositor1.Error.InvalidDisplayProfile
        org.hyprshelld.Compositor1.Error.InvalidCaller
        org.hyprshelld.Compositor1.Error.Unavailable
        org.hyprshelld.Compositor1.Error.ReadOnly
        org.hyprshelld.Compositor1.Error.StaleRevision
        org.hyprshelld.Compositor1.Error.StaleCatalogDigest
        org.hyprshelld.Compositor1.Error.DisplayScopeConflict
        org.hyprshelld.Compositor1.Error.DisplayTopologyChanged
        org.hyprshelld.Compositor1.Error.ActivationRequired
        org.hyprshelld.Compositor1.Error.VerificationFailed
        org.hyprshelld.Compositor1.Error.RuntimeUnavailable
        org.hyprshelld.Compositor1.Error.UnsupportedVersion
        org.hyprshelld.Compositor1.Error.ReloadFailed
        org.hyprshelld.Compositor1.Error.PersistenceFailed
        org.hyprshelld.Compositor1.Error.ApplyFailed
    -->
    <method name="PreviewDisplayConfiguration">
      <arg name="expectedRevision" type="t" direction="in"/>
      <arg name="expectedCatalogDigest" type="s" direction="in"/>
      <arg name="expectedActionCatalogDigest" type="s" direction="in"/>
      <arg name="profile" type="ay" direction="in"/>
      <arg name="timeoutSeconds" type="u" direction="in"/>
      <arg name="previewRevision" type="t" direction="out"/>
      <arg name="confirmationToken" type="s" direction="out"/>
      <arg name="deadlineMs" type="t" direction="out"/>
      <arg name="generationDigest" type="s" direction="out"/>
    </method>

    <!--
      Recovers an ambiguous Preview reply only for its initiating unique bus
      owner. Foreign and absent previews both return NoDisplayConfirmation so
      token ownership cannot be probed.

      Errors:
        org.hyprshelld.Compositor1.Error.NoDisplayConfirmation
    -->
    <method name="GetPendingDisplayConfirmation">
      <arg name="confirmationToken" type="s" direction="out"/>
      <arg name="previewRevision" type="t" direction="out"/>
      <arg name="deadlineMs" type="t" direction="out"/>
      <arg name="generationDigest" type="s" direction="out"/>
    </method>

    <!--
      Durably commits the exact receipt-bound preview, then finalizes ownership.
      Once the commit decision may exist, the token becomes non-actionable and
      no timeout, owner loss, retry, or opposite terminal action can roll back.

      Errors:
        org.hyprshelld.Compositor1.Error.NoDisplayConfirmation
        org.hyprshelld.Compositor1.Error.ConfirmationExpired
        org.hyprshelld.Compositor1.Error.DisplayTopologyChanged
        org.hyprshelld.Compositor1.Error.ApplyFailed
    -->
    <method name="ConfirmDisplayConfiguration">
      <arg name="confirmationToken" type="s" direction="in"/>
      <arg name="revision" type="t" direction="out"/>
      <arg name="generationDigest" type="s" direction="out"/>
    </method>

    <!--
      Rolls the preview back with exact live proof, then aborts N+1.

      Errors:
        org.hyprshelld.Compositor1.Error.NoDisplayConfirmation
        org.hyprshelld.Compositor1.Error.ApplyFailed
    -->
    <method name="RevertDisplayConfiguration">
      <arg name="confirmationToken" type="s" direction="in"/>
      <arg name="revision" type="t" direction="out"/>
    </method>

    <!--
      Explicitly retries the current failed effective shared-border tuple. A
      failed tuple otherwise retries only after its effective Config1 shared
      policy or derived compositor border values change, or compositor authority
      changes. A verified Config1 projection Revision-only change that leaves
      that policy and those values identical advances SharedBorderSourceRevision
      but does not retry. Source unavailability remains non-mutating.
    -->
    <method name="RetrySharedBorderSync"/>

    <!--
      Explicitly retries the current failed effective shared-spacing tuple and
      protected maximized-window rule. An unchanged failed tuple is otherwise
      suppressed until its effective spacing policy, compositor authority, or
      protected-rule state changes. A Revision-only source update advances the
      source revision without retrying.
    -->
    <method name="RetrySharedSpacingSync"/>
  </interface>
</node>
