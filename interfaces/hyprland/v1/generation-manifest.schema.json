{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://coastlinesec.github.io/hyprshelld/schemas/hyprland/v1/generation-manifest.schema.json",
  "title": "HyprShelld immutable Hyprland generation manifest v1",
  "$comment": "Schema validation alone is not activation authority. A Slice-2 reader MUST require entrypoint to be a files key, recompute every file size and SHA-256, recompute generation from the canonical manifest with generation omitted, and cross-check targetHyprland against compatibleHyprland.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "formatVersion",
    "contractVersion",
    "generation",
    "snapshotDigest",
    "catalogDigest",
    "actionCatalogDigest",
    "revision",
    "targetHyprland",
    "compatibleHyprland",
    "rendererVersion",
    "activationNonce",
    "createdAt",
    "entrypoint",
    "files"
  ],
  "properties": {
    "formatVersion": {"const": 1},
    "contractVersion": {"const": 1},
    "generation": {"$ref": "#/$defs/sha256"},
    "snapshotDigest": {"$ref": "#/$defs/sha256"},
    "catalogDigest": {"$ref": "#/$defs/sha256"},
    "actionCatalogDigest": {"$ref": "#/$defs/sha256"},
    "revision": {"$ref": "#/$defs/revision"},
    "targetHyprland": {"$ref": "#/$defs/hyprlandVersion"},
    "compatibleHyprland": {"$ref": "#/$defs/hyprlandRange"},
    "rendererVersion": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65535
    },
    "activationNonce": {
      "type": "string",
      "minLength": 32,
      "maxLength": 128,
      "pattern": "^[0-9a-f]+$"
    },
    "createdAt": {
      "type": "string",
      "maxLength": 32,
      "format": "date-time",
      "pattern": "Z$"
    },
    "entrypoint": {"$ref": "#/$defs/relativePath"},
    "files": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 64,
      "propertyNames": {"$ref": "#/$defs/relativePath"},
      "additionalProperties": {"$ref": "#/$defs/fileMetadata"}
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "revision": {
      "type": "string",
      "maxLength": 20,
      "pattern": "^(?:0|[1-9][0-9]{0,18}|(?:1[0-7][0-9]{18}|18[0-3][0-9]{17}|184[0-3][0-9]{16}|1844[0-5][0-9]{15}|18446[0-6][0-9]{14}|184467[0-3][0-9]{13}|1844674[0-3][0-9]{12}|184467440[0-6][0-9]{10}|1844674407[0-2][0-9]{9}|18446744073[0-6][0-9]{8}|1844674407370[0-8][0-9]{6}|18446744073709[0-4][0-9]{5}|184467440737095[0-4][0-9]{4}|18446744073709550[0-9]{3}|18446744073709551[0-5][0-9]{2}|1844674407370955160[0-9]|1844674407370955161[0-4]|18446744073709551615))$"
    },
    "hyprlandVersion": {
      "type": "string",
      "maxLength": 15,
      "pattern": "^0\\.56\\.(?:0|[1-9][0-9]{0,8}|[1-3][0-9]{9}|4[01][0-9]{8}|42[0-8][0-9]{7}|429[0-3][0-9]{6}|4294[0-8][0-9]{5}|42949[0-5][0-9]{4}|429496[0-6][0-9]{3}|4294967[01][0-9]{2}|42949672[0-8][0-9]|429496729[0-5])$"
    },
    "hyprlandRange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["major", "minor", "reviewedVersion", "minimumPatch", "maximumPatch"],
      "properties": {
        "major": {"const": 0},
        "minor": {"const": 56},
        "reviewedVersion": {"const": "0.56.1"},
        "minimumPatch": {"const": 0},
        "maximumPatch": {"const": null}
      }
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*(?:/[A-Za-z0-9][A-Za-z0-9._-]*)*$"
    },
    "fileMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha256", "size"],
      "properties": {
        "sha256": {"$ref": "#/$defs/sha256"},
        "size": {
          "type": "integer",
          "minimum": 0,
          "maximum": 16777216
        }
      }
    }
  }
}
