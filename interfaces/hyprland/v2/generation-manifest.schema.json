{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://coastlinesec.github.io/hyprshelld/schemas/hyprland/v2/generation-manifest.schema.json",
  "title": "HyprShelld dormant immutable Hyprland generation manifest v2",
  "$comment": "This schema is dormant qualification material. It does not change the production v1 renderer or generation verifier. A future v2 reader must cross-check authorityId before revision or digest, require entrypoint to be a files key, recompute every file size and SHA-256, recompute generation from the canonical manifest with generation omitted, and cross-check the exact source-manifest, catalog, and action-catalog authorities.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "formatVersion",
    "contractVersion",
    "authorityId",
    "generation",
    "snapshotDigest",
    "sourceManifestDigest",
    "catalogDigest",
    "actionCatalogDigest",
    "revision",
    "targetHyprland",
    "compatibleHyprland",
    "rendererVersion",
    "activationNonce",
    "createdAt",
    "entrypoint",
    "files"
  ],
  "properties": {
    "formatVersion": {"const": 2},
    "contractVersion": {"const": 2},
    "authorityId": {"$ref": "#/$defs/id128"},
    "generation": {"$ref": "#/$defs/sha256"},
    "snapshotDigest": {"$ref": "#/$defs/sha256"},
    "sourceManifestDigest": {"$ref": "#/$defs/sha256"},
    "catalogDigest": {"$ref": "#/$defs/sha256"},
    "actionCatalogDigest": {"$ref": "#/$defs/sha256"},
    "revision": {"$ref": "#/$defs/revision"},
    "targetHyprland": {"const": "0.56.2"},
    "compatibleHyprland": {"$ref": "#/$defs/hyprlandRange"},
    "rendererVersion": {"const": 2},
    "activationNonce": {"$ref": "#/$defs/id128"},
    "createdAt": {
      "type": "string",
      "maxLength": 32,
      "format": "date-time",
      "pattern": "Z$"
    },
    "entrypoint": {"$ref": "#/$defs/relativePath"},
    "files": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 64,
      "propertyNames": {"$ref": "#/$defs/relativePath"},
      "additionalProperties": {"$ref": "#/$defs/fileMetadata"}
    }
  },
  "$defs": {
    "id128": {
      "type": "string",
      "pattern": "^(?!0{32}$)[0-9a-f]{32}$",
      "$comment": "Exactly 128 random bits encoded as lowercase hexadecimal; the all-zero sentinel is forbidden."
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "revision": {
      "type": "string",
      "maxLength": 20,
      "pattern": "^(?:0|[1-9][0-9]{0,18}|(?:1[0-7][0-9]{18}|18[0-3][0-9]{17}|184[0-3][0-9]{16}|1844[0-5][0-9]{15}|18446[0-6][0-9]{14}|184467[0-3][0-9]{13}|1844674[0-3][0-9]{12}|184467440[0-6][0-9]{10}|1844674407[0-2][0-9]{9}|18446744073[0-6][0-9]{8}|1844674407370[0-8][0-9]{6}|18446744073709[0-4][0-9]{5}|184467440737095[0-4][0-9]{4}|18446744073709550[0-9]{3}|18446744073709551[0-5][0-9]{2}|1844674407370955160[0-9]|1844674407370955161[0-4]|18446744073709551615))$"
    },
    "hyprlandRange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["major", "minor", "reviewedVersion", "minimumPatch", "maximumPatch"],
      "properties": {
        "major": {"const": 0},
        "minor": {"const": 56},
        "reviewedVersion": {"const": "0.56.2"},
        "minimumPatch": {"const": 2},
        "maximumPatch": {"const": 2}
      }
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*(?:/[A-Za-z0-9][A-Za-z0-9._-]*)*$"
    },
    "fileMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha256", "size"],
      "properties": {
        "sha256": {"$ref": "#/$defs/sha256"},
        "size": {
          "type": "integer",
          "minimum": 0,
          "maximum": 16777216
        }
      }
    }
  }
}
